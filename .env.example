# Copy to .env (git-ignored) and replace every "change-me" value, or run
# `make env` to generate a .env with random secrets. Never commit the real .env.

# ---- InfluxDB 2 ----
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=uvfr
INFLUX_BUCKET=telemetry
INFLUX_RETENTION=30d
INFLUX_ADMIN_USER=uvfr-admin
INFLUX_ADMIN_PASSWORD=change-me-at-least-8-chars
# Admin (operator) token: administration and tests only.
INFLUX_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Address InfluxDB is published on. 127.0.0.1 = only processes on this VM
# (the pit receiver) can reach it. Use the VM's LAN IP once a separate pit
# laptop needs to write to it.
INFLUX_BIND=127.0.0.1

# Scoped tokens, created automatically by `make infra-up`
# (infrastructure/influxdb/create-tokens.sh). Leave empty here.
GRAFANA_INFLUX_TOKEN=
PIT_INFLUX_TOKEN=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# 0.0.0.0 publishes on the LAN (IPv4 only), filtered to private/VPN sources
# by infrastructure/firewall. Never port-forward this.
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
